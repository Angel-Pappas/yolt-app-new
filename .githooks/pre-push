#!/usr/bin/env bash
# Refuse a push that CI would fail on formatting or lint — the quick part of
# `composer ci:check` (ship.sh runs the full check before it pushes anyway; this
# catches a push made any other way). Enabled with: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! pnpm run --silent check >/dev/null 2>&1 || ! vendor/bin/pint --test >/dev/null 2>&1; then
    echo "pre-push: formatting/lint fails — run ./ship.sh (or pnpm run check:fix + vendor/bin/pint) first." >&2
    exit 1
fi
